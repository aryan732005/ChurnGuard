# Copy to churn-app/.env.local and fill in values

# Admin routes: /retrain, /logs, POST /api/retrain-simulation
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: Clerk auth for UI
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: NL explanations
OPENAI_API_KEY=

# Optional: email executive reports (POST /api/report/send)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Production CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
